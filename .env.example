# --- Sanity ---
# Identifiant du projet, visible sur sanity.io/manage.
# Les DEUX préfixes sont nécessaires et portent la MÊME valeur :
#   NEXT_PUBLIC_*   -> lu par le site Next
#   SANITY_STUDIO_* -> lu par le bundle du studio (il ignore NEXT_PUBLIC_)
# Tant qu'ils sont vides, le site sert le contenu de src/content/site.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Secret partagé avec le webhook Sanity : à définir dans Vercel, puis à recopier
# à l'identique côté Sanity. Une chaîne aléatoire longue.
# Génération : openssl rand -hex 32
SANITY_REVALIDATE_SECRET=
