# --- Sanity ---
# Identifiant du projet, visible sur sanity.io/manage. Tant qu'il est vide, le
# site sert le contenu de src/content/site.ts et rien ne casse.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret partagé avec le webhook Sanity, à définir dans Vercel puis à recopier
# à l'identique côté Sanity. Une chaîne aléatoire longue.
SANITY_REVALIDATE_SECRET=
