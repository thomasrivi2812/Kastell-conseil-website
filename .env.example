# --- WordPress (back-office headless) ---
# Adresse de l'installation WordPress, sans barre oblique finale.
# Pas de préfixe NEXT_PUBLIC_ : le domaine du back-office n'a rien à faire dans
# le bundle envoyé au navigateur.
# Tant qu'elle est vide, le site sert le contenu de src/content/site.ts.
WORDPRESS_API_URL=

# Secret partagé avec WordPress : à définir ici, puis à recopier à l'identique
# dans wp-config.php sous le nom KASTELL_SECRET.
# Génération : openssl rand -hex 32
REVALIDATE_SECRET=

# Destination des demandes du formulaire de contact.
# N'importe quel service acceptant un POST JSON : Brevo, Zapier, Make, n8n.
# SANS ELLE, LE FORMULAIRE NE PEUT RIEN ENVOYER : il le dit au visiteur et lui
# propose d'ouvrir son logiciel de messagerie avec le message déjà rédigé.
CONTACT_WEBHOOK_URL=

# Destination des adresses e-mail recueillies au téléchargement du manifeste.
# N'importe quel service acceptant un POST JSON : Zapier, Make, Brevo, n8n.
# Sans cette variable, l'adresse est journalisée et le document servi quand même.
MANIFESTE_WEBHOOK_URL=
